{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capto",
  "version": "1.0.0",
  "identifier": "com.elwina.capto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capto",
        "width": 460,
        "height": 760,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Elwina Vardal",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/capto-ffmpeg.json": "binaries/capto-ffmpeg.json",
      "binaries/capto.exe": "cli/capto.exe"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis/header.bmp",
        "sidebarImage": "windows/nsis/sidebar.bmp",
        "uninstallerHeaderImage": "windows/nsis/header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQTY5N0YxMDhBMjY0NUEKUldSYVpLSUk4WmVtaTJ6UE5ic0t5OWJKMmxvTjltY2tDTjhpbWx3SlI0MFJlbHFxeERjMndCcFEK",
      "endpoints": [
        "https://capto-update-proxy.elwina-vardal.workers.dev/updates/latest.json",
        "https://github.com/ciryanna/Capto/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
